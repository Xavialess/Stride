#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-adc.h>

/* 
 * I2C configuration for DRV2605L Haptic Driver
 * 
 * Board: Seeed XIAO BLE Sense (nRF52840)
 * The DRV2605L is connected via I2C at address 0x5A (default).
 * Using I2C1 bus which Arduino typically uses on expansion boards.
 */

/*
 * ADG884 motor mux GPIO control
 *
 * The DRV2605L differential pair (OUT+, OUT-) feeds the ADG884's two SPDT
 * channels (D1 -> ch1, D2 -> ch2).  Both IN pins are driven to the same
 * level so the full pair routes to one motor at a time:
 *
 *   IN1=IN2=LOW  -> A-side -> Motor 1 (left)   via S1A/S2A
 *   IN1=IN2=HIGH -> B-side -> Motor 2 (right)  via S1B/S2B
 *
 * D1 (P0.03) = IN1, D2 (P0.28) = IN2.
 */
/ {
	/*
	 * Battery voltage measurement
	 * BAT+ — 1MΩ — P0.31 (AIN7) — 1MΩ — GND
	 * P0.14 enables the divider (active-low, only during ADC sample).
	 */
	vbatt: vbatt {
		compatible = "voltage-divider";
		io-channels = <&adc 7>;
		/* No physical divider — P0.31 connects directly to BAT+.
		 * output-ohms == full-ohms means scale factor = 1 (no scaling). */
		output-ohms = <1>;
		full-ohms   = <1>;
	};

	motor_mux: motor_mux {
		compatible = "gpio-leds";
		mux_left: mux_left {
			gpios = <&xiao_d 1 GPIO_ACTIVE_HIGH>;
		};
		mux_right: mux_right {
			gpios = <&xiao_d 2 GPIO_ACTIVE_HIGH>;
		};
	};
};

/* SAADC channel 7 — AIN7 = P0.31, battery voltage divider input */
&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
		zephyr,resolution = <12>;
	};
};

/* Use I2C1 instead of I2C0 (different pins) */
&i2c1 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>; /* 100 kHz */
	
	pinctrl-0 = <&i2c1_default>;
	pinctrl-1 = <&i2c1_sleep>;
	pinctrl-names = "default", "sleep";
	
	drv2605l: drv2605l@5a {
		compatible = "ti,drv2605l";
		reg = <0x5a>;
		status = "okay";
	};
};
